# Copy this file to ".env" and fill in your own values.
# .env is git-ignored so your keys are never committed.

# ---- LLM provider ----
# One of: "openai" or "ollama"
LLM_PROVIDER=openai

# Required if LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Required if LLM_PROVIDER=ollama (local, free, no API key)
# Install Ollama from https://ollama.com and run: ollama pull llama3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ---- Embeddings ----
# Which embedding model the live app/API uses for retrieval.
# One of: "general" (all-MiniLM-L6-v2) or "medical" (PubMedBERT-based)
EMBEDDING_MODE=medical

# ---- Retrieval ----
TOP_K=4

# ---- Optional: used by evaluate_hallucination.py for LLM-as-judge scoring ----
JUDGE_MODEL=gpt-4o-mini
