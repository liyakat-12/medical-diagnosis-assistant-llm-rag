# Copy this file to ".env" and fill in your own values.
# Never commit real secrets.

APP_ENV=development
APP_DEBUG=true

# ---- MongoDB ----
# Local MongoDB (recommended):
MONGODB_URI=mongodb://127.0.0.1:27017
# For a disposable in-memory store when MongoDB is not installed, use:
# MONGODB_URI=memory
MONGODB_DB_NAME=mediassist

# ---- Auth ----
JWT_SECRET=change-this-to-a-long-random-string
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=14

# Comma-separated browser origins allowed to send cookies
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional demo account created on API startup
DEMO_EMAIL=demo@clinic.local
DEMO_PASSWORD=demo123
DEMO_NAME=Demo Patient

# ---- LLM provider ----
# One of: mock | groq | openai | ollama
LLM_PROVIDER=mock
LLM_MODEL=

# Required if LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Required if LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Required if LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ---- Embeddings / retrieval ----
EMBEDDING_MODE=general
TOP_K=4
RERANK_ENABLED=true
RERANK_CANDIDATES=12
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Optional: evaluate_hallucination.py
JUDGE_MODEL=gpt-4o-mini
