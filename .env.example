# Copy this file to ".env" and fill in your own values.
# Never commit .env or real secrets.

APP_ENV=development
APP_DEBUG=true

# ---- MongoDB ----
# Persistent accounts, sessions, and chat history (recommended):
MONGODB_URI=mongodb://127.0.0.1:27017
# Disposable in-memory store when MongoDB is not installed. Data is lost on restart:
# MONGODB_URI=memory
MONGODB_DB_NAME=mediassist

# ---- Auth ----
# Generate a local secret, for example:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating JWT_SECRET invalidates existing access and refresh cookies.
JWT_SECRET=replace-with-a-long-unique-local-secret
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=14

# Comma-separated browser origins allowed to send cookies.
# Do not use * when credentials/cookies are enabled.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional demo account created on API startup in development only.
# Leave DEMO_EMAIL empty, or set APP_ENV=production, to skip seeding.
DEMO_EMAIL=demo@clinic.local
DEMO_PASSWORD=demo123
DEMO_NAME=Demo Patient

# ---- Emergency guidance ----
# Used by deterministic emergency banners. Frontend Call buttons default to 112.
EMERGENCY_REGION=IN
EMERGENCY_NUMBER=112

# Bounded prior-message window passed into generation (not the whole chat).
CHAT_HISTORY_WINDOW=8

# ---- LLM provider ----
# One of: mock | groq | openai | ollama
LLM_PROVIDER=mock
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20
LLM_MEDICAL_MAX_TOKENS=280
LLM_GENERAL_MAX_TOKENS=1200

# Required if LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Required if LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# If local notes miss, Groq still fills the same match cards from general knowledge
LLM_KB_FALLBACK=true

# Required if LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ---- Embeddings / retrieval ----
EMBEDDING_MODE=general
TOP_K=4
RERANK_ENABLED=true
RERANK_CANDIDATES=12
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Drop match cards when the best retrieved chunk is below this cosine / sigmoid score
MIN_RELEVANCE_SCORE=0.22

# Optional: evaluate_hallucination.py
JUDGE_MODEL=gpt-4o-mini
