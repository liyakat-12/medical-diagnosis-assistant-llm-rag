# Copy this file to ".env" and fill in your own values.
# .env is git-ignored so your keys are never committed.

# ---- LLM provider ----
# One of: "openai", "groq", or "ollama"
LLM_PROVIDER=groq

# Required if LLM_PROVIDER=openai (paid)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Required if LLM_PROVIDER=groq (FREE, no credit card required)
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk-your-key-here
GROQ_MODEL=llama-3.1-8b-instant

# Required if LLM_PROVIDER=ollama (local, free, no API key, needs Ollama installed)
# Install Ollama from https://ollama.com and run: ollama pull llama3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ---- Embeddings ----
# Which embedding model the live app/API uses for retrieval.
# One of: "general" (all-MiniLM-L6-v2) or "medical" (PubMedBERT-based)
EMBEDDING_MODE=medical

# ---- Retrieval ----
TOP_K=4

# ---- Optional: used by evaluate_hallucination.py for LLM-as-judge scoring ----
JUDGE_MODEL=gpt-4o-mini
